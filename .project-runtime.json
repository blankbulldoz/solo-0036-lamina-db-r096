{
  "language": "Go",
  "project_shape": "backend",
  "source_extensions": [
    ".go"
  ],
  "build_command": "go build -o bin/laminad ./cmd/laminad && go build -o bin/lamina-consumer ./cmd/lamina-consumer",
  "testing": "deferred",
  "workflow_checks": [
    {
      "workflow_id": "catalog-create",
      "command": "python3 examples/walkthrough.py --workflow catalog-create"
    },
    {
      "workflow_id": "txn-write",
      "command": "python3 examples/walkthrough.py --workflow txn-write"
    },
    {
